        <!-- footer -->
        <mxCell id="footer" value="14 pipeline stages · exactly ONE calls an LLM · everything else is deterministic Python, OpenCV, pvlib and arithmetic. Every stage degrades rather than fails — a missing scrape, an unreachable S3 or no satellite clip narrows what the model sees and is logged, but does not stop a schedule being published. The LLM is the one exception, deliberately: publishing a physics-only schedule under this pipeline's name would misreport what produced it." style="text;html=1;fontSize=11;fontColor=#444444;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="2460" width="1470" height="60" as="geometry" />
