<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram name="Detailed Architecture" id="archDetailed">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="2000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- Title -->
        <mxCell id="title" value="Solar Forecasting Pipeline - Detailed Architecture" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1B4332;" vertex="1" parent="1">
          <mxGeometry x="140" y="20" width="900" height="36" as="geometry" />
        </mxCell>
        <mxCell id="caption" value="Team 2 - Sirmour Solar Plant, 5.1 MW - gemini-3.5-flash - amazon/chronos-bolt-small - pvlib Ineichen - ECMWF via Open-Meteo" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#495057;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="140" y="56" width="1100" height="24" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;div style=&quot;font-size:11px;color:#212529&quot;&gt;&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;Solid green = live in production&lt;br&gt;Dashed grey = built, currently OFF / unused in the forecast&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9ECEF;strokeColor=#495057;strokeWidth=1.5;fontColor=#212529;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1220" y="20" width="340" height="60" as="geometry" />
        </mxCell>

        <!-- N1 Capture -->
        <mxCell id="n1" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;1. Windy Satellite Capture&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;font-style:italic;margin-top:2px&quot;&gt;Playwright + Chromium (headless)&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:8px&quot;&gt;- Viewport 1280x720, zoom level 8&lt;br&gt;- Overlay: Satellite (VIS layer)&lt;br&gt;- 20-second animation clip recorded&lt;br&gt;- + solarpower &amp;amp; clouds still screenshots&lt;br&gt;- Fixed pixel-coordinate clicks for VIS/play buttons&lt;br&gt;- Uploaded to S3 (team bucket) after recording&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B4332;strokeColor=#40916C;fontColor=#FFFFFF;align=left;verticalAlign=top;spacing=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="680" y="100" width="480" height="190" as="geometry" />
        </mxCell>

        <!-- N2 Frame extraction -->
        <mxCell id="n2" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;2. Frame Extraction - OpenCV&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:8px&quot;&gt;- 10 frames, uniform sampling across the clip&lt;br&gt;- Saved in full colour (BGR) - NOT grayscale&lt;br&gt;- Skips the map-loading start &amp;amp; timeline loop-back&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B4332;strokeColor=#40916C;fontColor=#FFFFFF;align=left;verticalAlign=top;spacing=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="680" y="330" width="480" height="150" as="geometry" />
        </mxCell>

        <!-- N3 Vision LLM -->
        <mxCell id="n3" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;3. Vision LLM&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;font-style:italic;margin-top:2px&quot;&gt;Provider: Google Gemini - model gemini-3.5-flash&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:8px&quot;&gt;- Free tier · config-swappable (make_vision_client)&lt;br&gt;- Alt provider: GPT-4o (OpenAI) / OpenRouter free vision models&lt;br&gt;- temperature 0.2 · max_output_tokens 8192&lt;br&gt;- Retry: 3 attempts, exponential backoff (5s, 10s) on HTTP 503&lt;br&gt;- Reads all 10 frames together, chronologically&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B4332;strokeColor=#40916C;fontColor=#FFFFFF;align=left;verticalAlign=top;spacing=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="680" y="510" width="480" height="170" as="geometry" />
        </mxCell>

        <!-- N4 Features JSON -->
        <mxCell id="n4" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;4. Weather Features (JSON)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:8px&quot;&gt;- cloud_coverage_pct&lt;br&gt;- cloud_density (none / thin / moderate / thick)&lt;br&gt;- cloud_motion_direction + cloud_motion_speed&lt;br&gt;- moving_toward_plant (true/false)&lt;br&gt;- expected_change + minutes_until_change&lt;br&gt;- trend_next_2h / trend_2h_to_4h&lt;br&gt;- rain_probability_pct&lt;br&gt;- confidence (0.0 – 1.0)&lt;/div&gt;&lt;div style=&quot;font-size:11px;font-style:italic;margin-top:8px;color:#B7E4C7&quot;&gt;Only trend_next_2h, trend_2h_to_4h, minutes_until_change and confidence actually reach the forecast - the rest is cached and unused&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B4332;strokeColor=#40916C;fontColor=#FFFFFF;align=left;verticalAlign=top;spacing=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="680" y="710" width="480" height="280" as="geometry" />
        </mxCell>

        <!-- Optical flow (dashed, unused) -->
        <mxCell id="of" value="&lt;div style=&quot;font-size:13px&quot;&gt;&lt;b&gt;Optical Flow (Farneback)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;font-style:italic;margin-top:2px&quot;&gt;modules/vision/optical_flow.py&lt;/div&gt;&lt;div style=&quot;font-size:11px;margin-top:8px&quot;&gt;- Reads its own frames, converts to grayscale (required by Farneback - the only grayscale step in the project)&lt;br&gt;- Outputs cloud_cover_fraction, motion direction, speed_kmh&lt;br&gt;- Written as a JSON sidecar next to each clip&lt;/div&gt;&lt;div style=&quot;font-size:11px;font-style:italic;margin-top:8px&quot;&gt;NOT fed into the forecast - measured to carry no forward-predictive signal (monsoon cloud here builds convectively, not by drifting in)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#E9ECEF;strokeColor=#495057;strokeWidth=1.5;fontColor=#212529;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1220" y="330" width="340" height="220" as="geometry" />
        </mxCell>

        <!-- Frame preprocessor (dashed, off by default) -->
        <mxCell id="pre" value="&lt;div style=&quot;font-size:13px&quot;&gt;&lt;b&gt;Frame Preprocessor (OpenCV)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;font-style:italic;margin-top:2px&quot;&gt;modules/vision/frame_preprocessor.py&lt;/div&gt;&lt;div style=&quot;font-size:11px;margin-top:8px&quot;&gt;- Crop fixed Windy UI chrome&lt;br&gt;- CLAHE contrast enhancement on the L channel (LAB colour space) - keeps colour intact&lt;br&gt;- Optional fast denoising&lt;/div&gt;&lt;div style=&quot;font-size:11px;font-style:italic;margin-top:8px&quot;&gt;OFF by default (preprocess=False) - built for the mentor's OpenCV question, not yet validated enough to ship&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#E9ECEF;strokeColor=#495057;strokeWidth=1.5;fontColor=#212529;align=left;verticalAlign=top;spacing=8;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1220" y="580" width="340" height="200" as="geometry" />
        </mxCell>

        <!-- N5 Meter -->
        <mxCell id="n5" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Previous Meter Generation&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:8px&quot;&gt;- Historical CSVs (*_SOLAR_INV.csv), 15-min interval&lt;br&gt;- Validate → outlier removal → ffill/bfill → time-align to grid&lt;br&gt;- Pulled fresh from S3 before every run&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2D6A4F;strokeColor=#40916C;fontColor=#FFFFFF;align=left;verticalAlign=top;spacing=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="140" y="730" width="440" height="150" as="geometry" />
        </mxCell>

        <!-- N6 Weather -->
        <mxCell id="n6" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Weather Forecast&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:8px&quot;&gt;- ECMWF IFS 0.25° delivered via Open-Meteo (free, no key)&lt;br&gt;- Signal used: forecast shortwave radiation (GHI) - NOT cloud-cover %, which over-counts thin cirrus&lt;br&gt;- Bias-corrected: scaled by inverse of the median forecast/actual bias over the last 5 finished days&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2D6A4F;strokeColor=#40916C;fontColor=#FFFFFF;align=left;verticalAlign=top;spacing=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="140" y="900" width="440" height="170" as="geometry" />
        </mxCell>

        <!-- N7 Clearsky -->
        <mxCell id="n7" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;Clear-Sky Physics&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:8px&quot;&gt;- pvlib - Ineichen clear-sky model&lt;br&gt;- Performance ratio: 0.80&lt;br&gt;- tilt = latitude (24.56°) · azimuth = 180° (true south) - assumed, site value not provided&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2D6A4F;strokeColor=#40916C;fontColor=#FFFFFF;align=left;verticalAlign=top;spacing=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="140" y="1090" width="440" height="150" as="geometry" />
        </mxCell>

        <!-- N8 Blend -->
        <mxCell id="n8" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;5. Weighted Blend + Chronos&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:11px;font-style:italic;margin-top:2px&quot;&gt;Numbers → Numbers - no LLM involved&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:8px&quot;&gt;- Chronos: amazon/chronos-bolt-small, CPU, zero-shot&lt;br&gt;- final_kt = 0.65 x weather_kt + 0.35 x base_kt&lt;br&gt;- base_kt = (0.20 x context_ratio) x chronos_kt + persistence&lt;br&gt;- Vision adjusts persistence only - capped ≈ ±4% of the final number&lt;br&gt;- final_kw = final_kt x clear-sky curve (from N7), clipped to 5100 kW&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B4332;strokeColor=#40916C;fontColor=#FFFFFF;align=left;verticalAlign=top;spacing=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="680" y="1280" width="480" height="190" as="geometry" />
        </mxCell>

        <!-- N9 Case correction -->
        <mxCell id="n9" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;6. Case-Based Correction&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:8px&quot;&gt;- k = 40 nearest analogue blocks (by time-of-day, kt, horizon, forecast level)&lt;br&gt;- Applied at strength 0.5 - full strength (1.0) overfits and hurts&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B4332;strokeColor=#40916C;fontColor=#FFFFFF;align=left;verticalAlign=top;spacing=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="680" y="1510" width="480" height="130" as="geometry" />
        </mxCell>

        <!-- N10 Outputs -->
        <mxCell id="n10" value="&lt;div style=&quot;font-size:14px&quot;&gt;&lt;b&gt;7. Outputs&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:8px&quot;&gt;- &amp;lt;date&amp;gt;_&amp;lt;time&amp;gt;.csv - this run's 96-block forecast&lt;br&gt;- archive.csv - every run ever, append-only&lt;br&gt;- current_final_schedule.csv - actual (completed blocks) + forecast (blocks ahead)&lt;br&gt;- &amp;lt;date&amp;gt;_end_of_day_validation.json - after the 15:45 run&lt;br&gt;- Pushed to S3 → served by FastAPI dashboard + 3 JSON endpoints&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B4332;strokeColor=#40916C;fontColor=#FFFFFF;align=left;verticalAlign=top;spacing=10;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="680" y="1680" width="480" height="220" as="geometry" />
        </mxCell>

        <!-- Edges: main trunk -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2D6A4F;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1" source="n1" target="n2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2D6A4F;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1" source="n2" target="n3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2D6A4F;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1" source="n3" target="n4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2D6A4F;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1" source="n4" target="n8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2D6A4F;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1" source="n8" target="n9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2D6A4F;strokeWidth=2.5;endArrow=block;endFill=1;" edge="1" parent="1" source="n9" target="n10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Edges: side inputs into blend -->
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2D6A4F;strokeWidth=2.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="n5" target="n8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2D6A4F;strokeWidth=2.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n6" target="n8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2D6A4F;strokeWidth=2.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.7;" edge="1" parent="1" source="n7" target="n8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Edges: dashed unused branches -->
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#495057;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n1" target="of">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#495057;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="n2" target="pre">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
