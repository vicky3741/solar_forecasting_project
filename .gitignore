# Virtual environment
.venv/

# Environment variables / secrets
.env

# Windy premium browser session (equivalent to being logged in).
# NEVER commit this - Team 1 published theirs (windy_login.json) to a
# public repo, exposing their premium account to anyone who found it.
windy_session.json
windy_login.json

# Python cache
__pycache__/
*.pyc

# Generated outputs (frames, forecasts, reports - all reproducible/runtime artifacts)
outputs/

# Logs
logs/

# Windy videos pulled from S3 (large binaries, re-fetchable from the bucket)
data/windy/s3_cache/

# Auto-captured Windy videos (7x/day) - uploaded to S3, so re-fetchable
# from the bucket; keeping them out of git avoids large-binary bloat.
# The older July 9 clips were committed before this rule and stay tracked.
data/windy/videos/sirmour_*.webm
data/windy/new_videos/

# Per-layer still screenshots (solarpower/clouds) - also uploaded to S3
data/windy/screenshots/

# Cached Open-Meteo weather responses (re-fetchable from the free API)
data/weather/openmeteo_cache/

# Other re-fetchable weather caches: the model bake-off responses and the
# direct-from-ECMWF downloads. Same reasoning as openmeteo_cache above.
data/weather/bakeoff_cache/
data/weather/ecmwf_direct/

# Windy clips pulled down by tests/browse_videos.py for manual inspection.
# ~85 MB of binaries that all live in the S3 bucket already.
data/windy/downloaded/

# Optical-flow intermediates, regenerated on demand from the clips.
data/windy/flow_cache/

# Scratch space for one-off evaluation runs - never an input to anything.
data/tmp_eval/
